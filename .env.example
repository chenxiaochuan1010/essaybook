# 复制为 .env 后再按 NAS 的实际情况修改：
#   cp .env.example .env

# 运行容器的用户/组。NAS 上的 data/ 目录必须让这个用户可写。
# 用 `id` 查看；群晖常见 1026:100。
PUID=1000
PGID=1000

# 家庭内网模式：默认监听所有网卡，iPad/Mac 访问 http://NAS-IP:3000。
# 想只绑定 NAS 的局域网 IP，可改成 LAN_BIND=192.168.1.100，并给 NAS 做 DHCP 保留。
# 不要把 3000 端口转发到公网。
LAN_BIND=0.0.0.0
APP_PORT=3000

# 家庭内网用 HTTP 时设 false；如果以后用 Tailscale HTTPS，改成 true。
COOKIE_SECURE=false

TZ=Asia/Shanghai
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30
